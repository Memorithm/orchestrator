#!/usr/bin/env bash
set -u

# Pass non-agent invocations (notably `opencode --version` from doctor)
# straight to the real OpenCode binary.
if [[ "${1:-}" != "run" ]]; then
  exec "${ORCHESTRATOR_REAL_OPENCODE:?ORCHESTRATOR_REAL_OPENCODE is not set}" "$@"
fi

model=""
previous=""
for argument in "$@"; do
  if [[ "$previous" == "--model" ]]; then
    model="$argument"
    break
  fi
  previous="$argument"
done

if [[ -z "$model" ]]; then
  printf 'orchestrator opencode wrapper: missing --model\n' >&2
  exit 2
fi

case "$model" in
  ollama/*) model_id="${model#ollama/}" ;;
  *)
    printf 'orchestrator opencode wrapper: refusing non-Ollama model: %s\n' "$model" >&2
    exit 2
    ;;
esac

# Rust supplies the autonomous permission contract through
# OPENCODE_CONFIG_CONTENT. Extract only the permission object and pass it via
# OpenCode's dedicated runtime permission environment variable. This has a
# stronger boundary than a custom config file, which project-local config can
# otherwise override later in OpenCode's config precedence chain.
if [[ -n "${OPENCODE_CONFIG_CONTENT:-}" ]]; then
  permission_json="$(python3 - <<'PY'
import json
import os

config = json.loads(os.environ["OPENCODE_CONFIG_CONTENT"])
print(json.dumps(config.get("permission", {}), separators=(",", ":")))
PY
)" || exit 1
else
  permission_json='{}'
fi
unset OPENCODE_CONFIG_CONTENT

args=("$@")
last_index=$((${#args[@]} - 1))
is_ci_fix=0
if (( last_index >= 0 )) && [[ "${args[$last_index]}" == *"Task: FIX_CI"* ]]; then
  is_ci_fix=1
  args[$last_index]="${args[$last_index]}

CI repair hard requirement:
- Before concluding that no change is needed, inspect the current failing GitHub checks and workflow job logs.
- Reproduce the exact failing CI command, including any explicit Rust toolchain such as cargo +X.Y.Z.
- If the failure is formatting-only, apply formatting with that exact toolchain and leave the resulting changes in the working tree."
fi

# Deterministic repair comes before probabilistic repair. For a Rust CI-fix
# task, reproduce the formatter gate with the Orchestrator cargo wrapper. The
# wrapper mirrors an explicitly pinned `cargo +X.Y.Z fmt` from GitHub
# workflows. If the check fails but formatting succeeds and changes files,
# leave those edits in the worktree for Orchestrator's normal validation,
# commit and push path. The LLM still runs afterwards so it can inspect the
# failure and make additional changes if formatting was not sufficient.
if (( is_ci_fix == 1 )) && [[ -f Cargo.toml ]]; then
  printf '\n===== DETERMINISTIC CI PREFLIGHT =====\n'
  printf 'checking Rust formatting with repository CI toolchain policy\n'
  fmt_log="$(mktemp "${TMPDIR:-/tmp}/memorithm-rustfmt-check.XXXXXX.log")" || exit 1
  if cargo fmt --all -- --check >"$fmt_log" 2>&1; then
    printf 'rustfmt check: PASS\n'
  else
    printf 'rustfmt check: FAIL\n'
    cat "$fmt_log"
    printf '\napplying deterministic rustfmt repair\n'
    if cargo fmt --all; then
      if git diff --quiet -- .; then
        printf 'rustfmt repair produced no tracked changes\n'
      else
        printf 'rustfmt repair produced working-tree changes\n'
        args[$last_index]="${args[$last_index]}

Orchestrator deterministic preflight already applied the repository's CI-matched Rust formatter and left its changes in the working tree. Inspect that diff first. Keep it if correct; do not revert deterministic formatting merely to match a newer local rustfmt."
      fi
    else
      printf 'deterministic rustfmt repair could not be applied; delegating to agent\n' >&2
    fi
  fi
  rm -f "$fmt_log"
fi

printf '\n===== OLLAMA -> OPENCODE BRIDGE =====\n'
printf 'model: %s\n' "$model_id"
printf 'default plugins: disable requested\n'
printf 'claude compatibility: disabled\n'
printf 'permissions: runtime-enforced\n'
printf 'logs: INFO to stderr\n\n'

# Use Ollama's supported OpenCode integration. Disable default plugins and
# Claude compatibility sources so global user tooling is minimized during
# autonomous repository runs. Runtime permissions are supplied independently
# from project configuration.
PATH="${ORCHESTRATOR_ORIGINAL_PATH:?ORCHESTRATOR_ORIGINAL_PATH is not set}" \
OPENCODE_PERMISSION="$permission_json" \
OPENCODE_DISABLE_DEFAULT_PLUGINS=1 \
OPENCODE_DISABLE_CLAUDE_CODE=1 \
ollama launch opencode --model "$model_id" -- \
  --pure --print-logs --log-level INFO "${args[@]}"
status=$?

exit "$status"
