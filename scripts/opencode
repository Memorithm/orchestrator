#!/usr/bin/env bash
set -u

# Pass non-agent invocations (notably `opencode --version` from doctor)
# straight to the real OpenCode binary.
if [[ "${1:-}" != "run" ]]; then
  exec "${ORCHESTRATOR_REAL_OPENCODE:?ORCHESTRATOR_REAL_OPENCODE is not set}" "$@"
fi

model=""
previous=""
for argument in "$@"; do
  if [[ "$previous" == "--model" ]]; then
    model="$argument"
    break
  fi
  previous="$argument"
done

if [[ -z "$model" ]]; then
  printf 'orchestrator opencode wrapper: missing --model\n' >&2
  exit 2
fi

case "$model" in
  ollama/*) model_id="${model#ollama/}" ;;
  *)
    printf 'orchestrator opencode wrapper: refusing non-Ollama model: %s\n' "$model" >&2
    exit 2
    ;;
esac

# Rust supplies the autonomous permission contract through
# OPENCODE_CONFIG_CONTENT. Extract only the permission object and pass it via
# OpenCode's dedicated runtime permission environment variable.
if [[ -n "${OPENCODE_CONFIG_CONTENT:-}" ]]; then
  permission_json="$(python3 - <<'PY'
import json
import os

config = json.loads(os.environ["OPENCODE_CONFIG_CONTENT"])
print(json.dumps(config.get("permission", {}), separators=(",", ":")))
PY
)" || exit 1
else
  permission_json='{}'
fi
unset OPENCODE_CONFIG_CONTENT

args=("$@")
last_index=$((${#args[@]} - 1))
is_ci_fix=0
if (( last_index >= 0 )) && [[ "${args[$last_index]}" == *"Task: FIX_CI"* ]]; then
  is_ci_fix=1
  args[$last_index]="${args[$last_index]}

CI repair hard requirement:
- Inspect the current failing GitHub checks and workflow job logs.
- Reproduce the exact failing CI commands, including explicit Rust toolchains.
- Preserve any deterministic repair already left in the working tree.
- Continue until the reproduced local CI gates pass, or leave the narrowest safe partial fix with a precise blocker."
fi

validate_rust_ci() {
  local log_file="$1"

  if ! cargo fmt --all -- --check >"$log_file" 2>&1; then
    return 1
  fi
  if ! cargo check --workspace >"$log_file" 2>&1; then
    return 1
  fi
  if ! cargo clippy --workspace --all-targets -- -D warnings >"$log_file" 2>&1; then
    return 1
  fi
  if [[ "${ORCHESTRATOR_FULL_VALIDATION:-0}" == "1" ]]; then
    if ! cargo test --workspace >"$log_file" 2>&1; then
      return 1
    fi
  fi
  return 0
}

deterministic_changes=0

# Deterministic repair comes before probabilistic repair. For Rust CI-fix
# tasks, reproduce rustfmt with the repository CI toolchain selected by the
# Orchestrator cargo wrapper. If rustfmt changes tracked files, immediately
# exercise the standard Rust CI gates. A clean deterministic repair skips the
# LLM; a second failure is passed verbatim to the LLM in the same cycle.
if (( is_ci_fix == 1 )) && [[ -f Cargo.toml ]]; then
  printf '\n===== DETERMINISTIC CI PREFLIGHT =====\n'
  printf 'checking Rust formatting with repository CI toolchain policy\n'
  fmt_log="$(mktemp "${TMPDIR:-/tmp}/memorithm-rustfmt-check.XXXXXX.log")" || exit 1
  if cargo fmt --all -- --check >"$fmt_log" 2>&1; then
    printf 'rustfmt check: PASS\n'
  else
    printf 'rustfmt check: FAIL\n'
    cat "$fmt_log"
    printf '\napplying deterministic rustfmt repair\n'
    if cargo fmt --all; then
      if git diff --quiet -- .; then
        printf 'rustfmt repair produced no tracked changes\n'
      else
        deterministic_changes=1
        printf 'rustfmt repair produced working-tree changes\n'
      fi
    else
      printf 'deterministic rustfmt repair could not be applied; delegating to agent\n' >&2
    fi
  fi
  rm -f "$fmt_log"
fi

if (( deterministic_changes == 1 )); then
  printf '\n===== DETERMINISTIC FOLLOW-UP VALIDATION =====\n'
  validation_log="$(mktemp "${TMPDIR:-/tmp}/memorithm-ci-followup.XXXXXX.log")" || exit 1

  if validate_rust_ci "$validation_log"; then
    rm -f "$validation_log"
    printf 'deterministic repair passes local Rust CI gates\n'
    printf '\n===== DETERMINISTIC REPAIR COMPLETE =====\n'
    printf 'LLM skipped: deterministic repair is sufficient for this cycle.\n'
    exit 0
  fi

  printf 'deterministic repair exposed an additional CI failure\n'
  cat "$validation_log"
  followup_failure_log="$(tail -c 16000 "$validation_log")"
  rm -f "$validation_log"

  args[$last_index]="${args[$last_index]}

Orchestrator deterministic preflight already applied CI-matched rustfmt and then reproduced the next failing Rust CI gate. Keep the existing formatting diff unless it is demonstrably wrong. Repair this additional failure without unrelated refactoring.

Reproduced local CI failure (tail, up to 16000 bytes):
${followup_failure_log}"
fi

printf '\n===== OLLAMA -> OPENCODE BRIDGE =====\n'
printf 'model: %s\n' "$model_id"
printf 'default plugins: disable requested\n'
printf 'claude compatibility: disabled\n'
printf 'permissions: runtime-enforced\n'
printf 'agent cargo bridge: enabled\n'
printf 'logs: INFO to stderr\n\n'

run_agent_once() {
  PATH="${ORCHESTRATOR_AGENT_PATH:?ORCHESTRATOR_AGENT_PATH is not set}" \
  OPENCODE_PERMISSION="$permission_json" \
  OPENCODE_DISABLE_DEFAULT_PLUGINS=1 \
  OPENCODE_DISABLE_CLAUDE_CODE=1 \
  ollama launch opencode --model "$model_id" -- \
    --pure --print-logs --log-level INFO "${args[@]}"
}

# First probabilistic repair pass.
run_agent_once
status=$?
if (( status != 0 )); then
  exit "$status"
fi

# For CI repair work, never hand control back to the Rust commit/push path
# until the same local Rust gates have been replayed after agent edits. Give
# the agent one bounded follow-up pass with the exact residual failure before
# failing the cycle closed.
if (( is_ci_fix == 1 )) && [[ -f Cargo.toml ]]; then
  printf '\n===== POST-AGENT CI VALIDATION =====\n'
  post_log="$(mktemp "${TMPDIR:-/tmp}/memorithm-post-agent-ci.XXXXXX.log")" || exit 1

  if validate_rust_ci "$post_log"; then
    rm -f "$post_log"
    printf 'post-agent Rust CI gates: PASS\n'
    exit 0
  fi

  printf 'post-agent Rust CI gates: FAIL\n'
  cat "$post_log"
  residual_log="$(tail -c 16000 "$post_log")"
  rm -f "$post_log"

  args[$last_index]="${args[$last_index]}

Follow-up repair pass: your previous edits are still in the working tree, but the reproduced Rust CI gates remain red. Do not restart or revert correct prior changes. Repair only the residual failure below, then run the relevant CI-matched commands again.

Residual local CI failure (tail, up to 16000 bytes):
${residual_log}"

  printf '\n===== OPENCODE FOLLOW-UP PASS =====\n'
  run_agent_once
  status=$?
  if (( status != 0 )); then
    exit "$status"
  fi

  final_log="$(mktemp "${TMPDIR:-/tmp}/memorithm-final-agent-ci.XXXXXX.log")" || exit 1
  if validate_rust_ci "$final_log"; then
    rm -f "$final_log"
    printf 'final Rust CI gates: PASS\n'
    exit 0
  fi

  printf 'final Rust CI gates: FAIL; refusing commit/push\n' >&2
  cat "$final_log" >&2
  rm -f "$final_log"
  exit 1
fi

exit 0
