#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" != "--" ]]; then
  printf 'agent sandbox usage: agent-sandbox -- command [args...]\n' >&2
  exit 2
fi
shift
if [[ "$#" -eq 0 ]]; then
  printf 'agent sandbox: missing command\n' >&2
  exit 2
fi

BWRAP="${ORCHESTRATOR_REAL_BWRAP:?ORCHESTRATOR_REAL_BWRAP is not set}"
DATA_ROOT="${ORCHESTRATOR_DATA_ROOT:?ORCHESTRATOR_DATA_ROOT is not set}"
HOST_HOME="${ORCHESTRATOR_HOST_ACCOUNT_HOME:?ORCHESTRATOR_HOST_ACCOUNT_HOME is not set}"
RUNTIME_HOME="${ORCHESTRATOR_RUNTIME_HOME:?ORCHESTRATOR_RUNTIME_HOME is not set}"
AGENT_HOME="${ORCHESTRATOR_AGENT_HOME:?ORCHESTRATOR_AGENT_HOME is not set}"
AGENT_WRAPPERS="${ORCHESTRATOR_AGENT_WRAPPER_DIR:?ORCHESTRATOR_AGENT_WRAPPER_DIR is not set}"
REAL_CARGO="${ORCHESTRATOR_REAL_CARGO:?ORCHESTRATOR_REAL_CARGO is not set}"
REAL_OPENCODE="${ORCHESTRATOR_REAL_OPENCODE:?ORCHESTRATOR_REAL_OPENCODE is not set}"
RUSTUP_HOME_HOST="${RUSTUP_HOME:-$HOST_HOME/.rustup}"
CARGO_HOME_HOST="${CARGO_HOME:-$DATA_ROOT/cargo-home}"

WORKSPACE="$(pwd -P)"
WORKSPACES_ROOT="$(realpath -m "$DATA_ROOT/workspaces")"
case "$WORKSPACE" in
  "$WORKSPACES_ROOT"/*) ;;
  *)
    printf 'agent sandbox: refusing workspace outside %s: %s\n' "$WORKSPACES_ROOT" "$WORKSPACE" >&2
    exit 2
    ;;
esac

for required in \
  "$BWRAP" \
  "$WORKSPACE/.git" \
  "$AGENT_HOME" \
  "$AGENT_WRAPPERS" \
  "$REAL_CARGO" \
  "$REAL_OPENCODE" \
  "$RUSTUP_HOME_HOST" \
  "$CARGO_HOME_HOST"; do
  if [[ ! -e "$required" ]]; then
    printf 'agent sandbox: required path missing: %s\n' "$required" >&2
    exit 2
  fi
done

CARGO_BIN_HOST="$(dirname "$REAL_CARGO")"
OPENCODE_BIN_HOST="$(dirname "$REAL_OPENCODE")"
REAL_GIT="${ORCHESTRATOR_REAL_GIT:-$(command -v git)}"
REAL_GH="${ORCHESTRATOR_REAL_GH:-$(command -v gh)}"

# The worker gets an explicit environment allowlist. Credentials, host HOME,
# arbitrary plugin/provider settings and credential helper variables are not
# forwarded into the coding process.
env_args=(
  --clearenv
  --setenv HOME /tmp/orchestrator/agent-home
  --setenv XDG_CONFIG_HOME /tmp/orchestrator/agent-home/.config
  --setenv XDG_DATA_HOME /tmp/orchestrator/agent-home/.local/share
  --setenv XDG_CACHE_HOME /tmp/orchestrator/agent-home/.cache
  --setenv GH_CONFIG_DIR /tmp/orchestrator/agent-home/.config/gh-empty
  --setenv CARGO_HOME /tmp/orchestrator/cargo-home
  --setenv RUSTUP_HOME /tmp/orchestrator/rustup
  --setenv TMPDIR /tmp
  --setenv LANG "${LANG:-C.UTF-8}"
  --setenv LC_ALL "${LC_ALL:-C.UTF-8}"
  --setenv OLLAMA_HOST "${OLLAMA_HOST:-http://127.0.0.1:11434}"
  --setenv ORCHESTRATOR_REAL_CARGO /tmp/orchestrator/cargo-bin/cargo
  --setenv ORCHESTRATOR_REAL_GIT "$REAL_GIT"
  --setenv ORCHESTRATOR_REAL_GH "$REAL_GH"
  --setenv ORCHESTRATOR_AGENT_PATH /tmp/orchestrator/agent-bin:/tmp/orchestrator/cargo-bin:/tmp/orchestrator/opencode-bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
  --setenv PATH /tmp/orchestrator/agent-bin:/tmp/orchestrator/cargo-bin:/tmp/orchestrator/opencode-bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
  --setenv OPENCODE_PERMISSION "${OPENCODE_PERMISSION:-{}}"
  --setenv OPENCODE_DISABLE_DEFAULT_PLUGINS 1
  --setenv OPENCODE_DISABLE_CLAUDE_CODE 1
  --setenv OPENCODE_DISABLE_CLAUDE_CODE_PROMPT 1
  --setenv OPENCODE_DISABLE_CLAUDE_CODE_SKILLS 1
  --setenv OPENCODE_DISABLE_PROJECT_CONFIG 1
  --setenv OPENCODE_DISABLE_EXTERNAL_SKILLS 1
  --setenv OPENCODE_DISABLE_AUTOUPDATE 1
  --setenv OPENCODE_DISABLE_LSP_DOWNLOAD 1
  --setenv OPENCODE_DISABLE_MODELS_FETCH 1
  --setenv OPENCODE_AUTO_SHARE 0
  --setenv OPENCODE_PURE 1
)

# Pass only non-secret native build/runtime knobs used by Rust/CUDA/WGPU work.
for name in \
  CUDA_HOME CUDA_PATH LD_LIBRARY_PATH LIBRARY_PATH CPATH PKG_CONFIG_PATH \
  CMAKE_PREFIX_PATH RUSTFLAGS RUSTDOCFLAGS RUST_BACKTRACE CC CXX AR VULKAN_SDK; do
  if [[ -n "${!name:-}" ]]; then
    env_args+=(--setenv "$name" "${!name}")
  fi
done

# Bubblewrap's private /dev contains only safe basic devices. Add back known
# GPU compute/render nodes explicitly; never expose block devices, /dev/mem or
# the host's complete device tree.
device_args=(--dev /dev)
shopt -s nullglob
for device in \
  /dev/nvidia* \
  /dev/nvhost-* \
  /dev/nvgpu \
  /dev/nvmap \
  /dev/kfd \
  /dev/dri/renderD* \
  /dev/dri/card* \
  /dev/dxg; do
  [[ -e "$device" ]] || continue
  device_args+=(--dev-bind "$device" "$device")
done
shopt -u nullglob

# Hide account/runtime homes and host service/system state after the required
# toolchain/workspace bind mounts have been established below.
mask_args=()
add_tmpfs_mask() {
  local path="$1"
  [[ -n "$path" && -e "$path" ]] || return 0
  mask_args+=(--tmpfs "$path")
}
add_file_mask() {
  local path="$1"
  [[ -f "$path" ]] || return 0
  mask_args+=(--ro-bind /dev/null "$path")
}

add_tmpfs_mask "$HOST_HOME"
case "$RUNTIME_HOME" in
  "$HOST_HOME"|"$HOST_HOME"/*) ;;
  *) add_tmpfs_mask "$RUNTIME_HOME" ;;
esac
for path in /home /run /var/lib /var/log /mnt /media /srv; do
  add_tmpfs_mask "$path"
done
for path in /etc/ssh /etc/wpa_supplicant /etc/NetworkManager/system-connections; do
  add_tmpfs_mask "$path"
done
for path in /etc/shadow /etc/gshadow /etc/memorithm-orchestrator.env; do
  add_file_mask "$path"
done

exec "$BWRAP" \
  --die-with-parent \
  --new-session \
  --unshare-user \
  --uid 0 \
  --gid 0 \
  --unshare-pid \
  --unshare-ipc \
  --unshare-uts \
  --unshare-cgroup-try \
  --cap-drop ALL \
  --ro-bind / / \
  "${device_args[@]}" \
  --proc /proc \
  --tmpfs /tmp \
  --dir /tmp/orchestrator \
  --bind "$WORKSPACE" /tmp/orchestrator/workspace \
  --ro-bind "$WORKSPACE/.git" /tmp/orchestrator/workspace/.git \
  --bind "$AGENT_HOME" /tmp/orchestrator/agent-home \
  --ro-bind "$AGENT_WRAPPERS" /tmp/orchestrator/agent-bin \
  --bind "$CARGO_HOME_HOST" /tmp/orchestrator/cargo-home \
  --ro-bind "$RUSTUP_HOME_HOST" /tmp/orchestrator/rustup \
  --ro-bind "$CARGO_BIN_HOST" /tmp/orchestrator/cargo-bin \
  --ro-bind "$OPENCODE_BIN_HOST" /tmp/orchestrator/opencode-bin \
  "${mask_args[@]}" \
  --chdir /tmp/orchestrator/workspace \
  "${env_args[@]}" \
  -- \
  "$@"
