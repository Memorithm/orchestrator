#!/usr/bin/env bash
set -euo pipefail

CORE="${ORCHESTRATOR_OPENCODE_CORE:?ORCHESTRATOR_OPENCODE_CORE is not set}"
AGENT_HOME="${ORCHESTRATOR_AGENT_HOME:?ORCHESTRATOR_AGENT_HOME is not set}"
AGENT_CONFIG="${ORCHESTRATOR_AGENT_CONFIG_DIR:?ORCHESTRATOR_AGENT_CONFIG_DIR is not set}"
AGENT_DATA="${ORCHESTRATOR_AGENT_DATA_DIR:?ORCHESTRATOR_AGENT_DATA_DIR is not set}"
AGENT_CACHE="${ORCHESTRATOR_AGENT_CACHE_DIR:?ORCHESTRATOR_AGENT_CACHE_DIR is not set}"
GH_CONFIG="${ORCHESTRATOR_GH_CONFIG_DIR:?ORCHESTRATOR_GH_CONFIG_DIR is not set}"

mkdir -p "$AGENT_HOME" "$AGENT_CONFIG" "$AGENT_DATA" "$AGENT_CACHE"

# The coding worker must not inherit personal OpenCode configuration, plugins,
# skills, sessions, or provider state from the host account. GitHub auth is
# preserved explicitly through GH_CONFIG_DIR for the read-only gh bridge.
export HOME="$AGENT_HOME"
export XDG_CONFIG_HOME="$AGENT_CONFIG"
export XDG_DATA_HOME="$AGENT_DATA"
export XDG_CACHE_HOME="$AGENT_CACHE"
export GH_CONFIG_DIR="$GH_CONFIG"

export OPENCODE_CONFIG_DIR="$AGENT_CONFIG/opencode-managed"
export OPENCODE_DISABLE_PROJECT_CONFIG=1
export OPENCODE_DISABLE_EXTERNAL_SKILLS=1
export OPENCODE_DISABLE_DEFAULT_PLUGINS=1
export OPENCODE_DISABLE_CLAUDE_CODE=1
export OPENCODE_DISABLE_CLAUDE_CODE_PROMPT=1
export OPENCODE_DISABLE_CLAUDE_CODE_SKILLS=1
export OPENCODE_DISABLE_AUTOUPDATE=1
export OPENCODE_DISABLE_LSP_DOWNLOAD=1
export OPENCODE_DISABLE_MODELS_FETCH=1
export OPENCODE_AUTO_SHARE=0
export OPENCODE_PURE=1

mkdir -p "$OPENCODE_CONFIG_DIR"

# Autonomous research is a parent-side prompt/state transformation. Intercept
# only the exact autonomous argv shape emitted by Rust. Doctor/self-test and
# unsupported invocations retain the historical delegation contract and are
# validated by the core wrapper itself.
if [[ "$#" -eq 4 && "${1:-}" == "run" && "${2:-}" == "--auto" && "${3:-}" == "--model" ]]; then
  if [[ -t 0 ]]; then
    printf 'orchestrator opencode environment: refusing TTY stdin for autonomous run\n' >&2
    exit 2
  fi

  agent_prompt="$(cat)"
  if [[ -z "$agent_prompt" ]]; then
    printf 'orchestrator opencode environment: empty autonomous prompt on stdin\n' >&2
    exit 2
  fi

  wrapper_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  helper="${ORCHESTRATOR_RESEARCH_PROMPT_HELPER:-$wrapper_dir/../release/orchestrator-research-prompt}"
  if [[ ! -x "$helper" ]]; then
    printf 'orchestrator opencode environment: research prompt helper unavailable: %s\n' "$helper" >&2
    exit 70
  fi

  transformed_prompt="$(printf '%s' "$agent_prompt" | "$helper" transform)" || {
    status=$?
    printf 'orchestrator opencode environment: research prompt validation failed\n' >&2
    exit "$status"
  }

  # Do not exec here: the parent-side bridge must consume and remove the
  # reserved research handoff after the worker exits, before Rust inspects the
  # managed workspace diff. Preserve the worker status unless a successful
  # worker violates the research handoff contract.
  set +e
  bash "$CORE" "$@" < <(printf '%s' "$transformed_prompt")
  core_status=$?
  set -e

  record_status=0
  printf '%s' "$agent_prompt" | "$helper" record "$core_status" || record_status=$?
  if (( record_status != 0 )); then
    printf 'orchestrator opencode environment: research cycle recording failed with status %s\n' "$record_status" >&2
    if (( core_status == 0 )); then
      exit "$record_status"
    fi
  fi
  exit "$core_status"
fi

exec bash "$CORE" "$@"
