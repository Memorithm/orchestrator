#!/usr/bin/env bash
set -euo pipefail

CORE="${ORCHESTRATOR_OPENCODE_CORE:?ORCHESTRATOR_OPENCODE_CORE is not set}"
AGENT_HOME="${ORCHESTRATOR_AGENT_HOME:?ORCHESTRATOR_AGENT_HOME is not set}"
AGENT_CONFIG="${ORCHESTRATOR_AGENT_CONFIG_DIR:?ORCHESTRATOR_AGENT_CONFIG_DIR is not set}"
AGENT_DATA="${ORCHESTRATOR_AGENT_DATA_DIR:?ORCHESTRATOR_AGENT_DATA_DIR is not set}"
AGENT_CACHE="${ORCHESTRATOR_AGENT_CACHE_DIR:?ORCHESTRATOR_AGENT_CACHE_DIR is not set}"

mkdir -p "$AGENT_HOME" "$AGENT_CONFIG" "$AGENT_DATA" "$AGENT_CACHE" "$AGENT_CONFIG/gh-empty"

# The coding worker must not inherit personal OpenCode configuration, plugins,
# skills, sessions, provider state, or GitHub credentials from the host account.
export HOME="$AGENT_HOME"
export XDG_CONFIG_HOME="$AGENT_CONFIG"
export XDG_DATA_HOME="$AGENT_DATA"
export XDG_CACHE_HOME="$AGENT_CACHE"
export GH_CONFIG_DIR="$AGENT_CONFIG/gh-empty"
unset GH_TOKEN GITHUB_TOKEN SSH_AUTH_SOCK GIT_ASKPASS GIT_CONFIG_GLOBAL

export OPENCODE_CONFIG_DIR="$AGENT_CONFIG/opencode-managed"
export OPENCODE_DISABLE_PROJECT_CONFIG=1
export OPENCODE_DISABLE_EXTERNAL_SKILLS=1
export OPENCODE_DISABLE_DEFAULT_PLUGINS=1
export OPENCODE_DISABLE_CLAUDE_CODE=1
export OPENCODE_DISABLE_CLAUDE_CODE_PROMPT=1
export OPENCODE_DISABLE_CLAUDE_CODE_SKILLS=1
export OPENCODE_DISABLE_AUTOUPDATE=1
export OPENCODE_DISABLE_LSP_DOWNLOAD=1
export OPENCODE_DISABLE_MODELS_FETCH=1
export OPENCODE_AUTO_SHARE=0
export OPENCODE_PURE=1

mkdir -p "$OPENCODE_CONFIG_DIR"

exec bash "$CORE" "$@"
