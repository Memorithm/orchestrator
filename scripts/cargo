#!/usr/bin/env bash
set -u

real_cargo="${ORCHESTRATOR_REAL_CARGO:?ORCHESTRATOR_REAL_CARGO is not set}"

# Respect an explicit toolchain selected by the caller.
if [[ "${1:-}" == +* ]]; then
  exec "$real_cargo" "$@"
fi

# rustfmt output is version-sensitive. Infer the formatter toolchain from
# explicit `cargo +<toolchain> fmt` commands in GitHub workflows, but take the
# repository's rustfmt configuration into account before deciding whether
# multiple pins are actually contradictory.
#
# In particular, a root rustfmt.toml/.rustfmt.toml with
# `unstable_features = true` cannot be formatted correctly on stable/MSRV.
# In that case only nightly formatter pins are admissible; stable/MSRV fmt
# commands elsewhere in the workflow matrix are secondary checks and must not
# override the canonical nightly formatter.
unstable_rustfmt=0
for rustfmt_config in rustfmt.toml .rustfmt.toml; do
  if [[ -f "$rustfmt_config" ]] && grep -Eq '^[[:space:]]*unstable_features[[:space:]]*=[[:space:]]*true([[:space:]]*(#.*)?)?$' "$rustfmt_config"; then
    unstable_rustfmt=1
    break
  fi
done

toolchain=""
if [[ -d .github/workflows ]]; then
  while IFS= read -r workflow; do
    while IFS= read -r matched; do
      [[ -n "$matched" ]] || continue
      candidate="$(printf '%s\n' "$matched" | sed -E 's/^cargo \+([^ ]+) fmt$/\1/')"

      # An unstable rustfmt configuration requires nightly. Ignore stable/MSRV
      # formatter invocations that cannot honor that configuration.
      if [[ "$unstable_rustfmt" -eq 1 && "$candidate" != nightly* ]]; then
        continue
      fi

      if [[ -z "$toolchain" ]]; then
        toolchain="$candidate"
      elif [[ "$toolchain" != "$candidate" ]]; then
        printf 'orchestrator cargo wrapper: conflicting admissible fmt toolchains: %s and %s\n' "$toolchain" "$candidate" >&2
        exit 2
      fi
    done < <(
      grep -Eho 'cargo \+(nightly-[0-9]{4}-[0-9]{2}-[0-9]{2}|[0-9]+\.[0-9]+\.[0-9]+|stable|beta|nightly) fmt' "$workflow" 2>/dev/null | sort -u
    )
  done < <(find .github/workflows -maxdepth 1 -type f \( -name '*.yml' -o -name '*.yaml' \) -print | sort)
fi

if [[ "$unstable_rustfmt" -eq 1 && -z "$toolchain" ]]; then
  printf 'orchestrator cargo wrapper: rustfmt unstable_features=true but no explicit nightly fmt toolchain was found in CI\n' >&2
  exit 2
fi

if [[ -n "$toolchain" ]]; then
  printf '[orchestrator cargo] using CI-pinned Rust %s\n' "$toolchain" >&2
  exec "$real_cargo" "+$toolchain" "$@"
fi

exec "$real_cargo" "$@"
