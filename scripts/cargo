#!/usr/bin/env bash
set -u

real_cargo="${ORCHESTRATOR_REAL_CARGO:?ORCHESTRATOR_REAL_CARGO is not set}"

# Respect an explicit toolchain selected by the caller.
if [[ "${1:-}" == +* ]]; then
  exec "$real_cargo" "$@"
fi

# When a repository's GitHub workflow explicitly pins rustfmt, use that same
# toolchain for Orchestrator's cargo calls. rustfmt output is version-sensitive,
# and repositories such as SciRust deliberately require a dated nightly because
# their rustfmt.toml enables unstable formatting options.
#
# Supported explicit CI forms include:
#   cargo +1.89.0 fmt ...
#   cargo +nightly-2026-07-02 fmt ...
#   cargo +stable fmt ...
#   cargo +beta fmt ...
#   cargo +nightly fmt ...
toolchain=""
if [[ -d .github/workflows ]]; then
  while IFS= read -r workflow; do
    while IFS= read -r matched; do
      [[ -n "$matched" ]] || continue
      candidate="$(printf '%s\n' "$matched" | sed -E 's/^cargo \+([^ ]+) fmt$/\1/')"
      if [[ -z "$toolchain" ]]; then
        toolchain="$candidate"
      elif [[ "$toolchain" != "$candidate" ]]; then
        printf 'orchestrator cargo wrapper: conflicting pinned fmt toolchains: %s and %s\n' "$toolchain" "$candidate" >&2
        exit 2
      fi
    done < <(
      grep -Eho 'cargo \+(nightly-[0-9]{4}-[0-9]{2}-[0-9]{2}|[0-9]+\.[0-9]+\.[0-9]+|stable|beta|nightly) fmt' "$workflow" 2>/dev/null | sort -u
    )
  done < <(find .github/workflows -maxdepth 1 -type f \( -name '*.yml' -o -name '*.yaml' \) -print | sort)
fi

if [[ -n "$toolchain" ]]; then
  printf '[orchestrator cargo] using CI-pinned Rust %s\n' "$toolchain" >&2
  exec "$real_cargo" "+$toolchain" "$@"
fi

exec "$real_cargo" "$@"
