#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" != "--cwd" || -z "${2:-}" ]]; then
  printf 'validation sandbox usage: validation-sandbox --cwd RELATIVE -- command [args...]\n' >&2
  exit 2
fi
RELATIVE_CWD="$2"
shift 2
if [[ "${1:-}" != "--" ]]; then
  printf 'validation sandbox: expected -- before command\n' >&2
  exit 2
fi
shift
if [[ "$#" -eq 0 ]]; then
  printf 'validation sandbox: missing command\n' >&2
  exit 2
fi

case "$RELATIVE_CWD" in
  .) ;;
  /*|*\\*|*:*|*/|../*|*/../*|*/..|..|./*|*/./*|*/.)
    printf 'validation sandbox: unsafe relative cwd: %s\n' "$RELATIVE_CWD" >&2
    exit 2
    ;;
esac

BWRAP="${ORCHESTRATOR_REAL_BWRAP:-$(command -v bwrap || true)}"
DATA_ROOT="${ORCHESTRATOR_DATA_ROOT:?ORCHESTRATOR_DATA_ROOT is not set}"
if [[ -z "$BWRAP" || ! -x "$BWRAP" ]]; then
  printf 'validation sandbox: bubblewrap is unavailable\n' >&2
  exit 2
fi

WORKSPACE="$(pwd -P)"
WORKSPACES_ROOT="$(realpath -m "$DATA_ROOT/workspaces")"
case "$WORKSPACE" in
  "$WORKSPACES_ROOT"/*) ;;
  *)
    printf 'validation sandbox: refusing workspace outside %s: %s\n' "$WORKSPACES_ROOT" "$WORKSPACE" >&2
    exit 2
    ;;
esac
if [[ ! -d "$WORKSPACE/.git" ]]; then
  printf 'validation sandbox: managed workspace is missing .git: %s\n' "$WORKSPACE" >&2
  exit 2
fi

HOST_HOME="${ORCHESTRATOR_HOST_ACCOUNT_HOME:-}"
if [[ -z "$HOST_HOME" ]]; then
  HOST_HOME="$(getent passwd "$(id -u)" | awk -F: 'NR == 1 { print $6 }')"
fi
if [[ -z "$HOST_HOME" ]]; then
  HOST_HOME="${HOME:-/root}"
fi
RUNTIME_HOME="${ORCHESTRATOR_RUNTIME_HOME:-${HOME:-$HOST_HOME}}"
CARGO_HOME_HOST="${CARGO_HOME:-$DATA_ROOT/cargo-home}"
RUSTUP_HOME_HOST="${RUSTUP_HOME:-$HOST_HOME/.rustup}"
REAL_CARGO="${ORCHESTRATOR_REAL_CARGO:-$(command -v cargo || true)}"

internal_root=/tmp/orchestrator
internal_workspace="$internal_root/workspace"
internal_cargo_home="$internal_root/cargo-home"
internal_rustup="$internal_root/rustup"
internal_cargo_bin="$internal_root/cargo-bin"
internal_home="$internal_root/home"
internal_cwd="$internal_workspace"
if [[ "$RELATIVE_CWD" != "." ]]; then
  internal_cwd="$internal_workspace/$RELATIVE_CWD"
fi

mount_args=(
  --ro-bind / /
  --dev /dev
  --proc /proc
  --tmpfs /tmp
  --dir "$internal_root"
  --dir "$internal_home"
  --bind "$WORKSPACE" "$internal_workspace"
  --ro-bind "$WORKSPACE/.git" "$internal_workspace/.git"
  --dir "$internal_cargo_home"
)

safe_path=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
if [[ -n "$REAL_CARGO" && -x "$REAL_CARGO" ]]; then
  CARGO_BIN_HOST="$(dirname "$(realpath "$REAL_CARGO")")"
  # If cargo is a rustup shim, realpath may point into the toolchain. Prefer the
  # directory exposed on PATH so cargo/rustc/rustfmt shims stay together.
  CARGO_PATH_ENTRY="$(dirname "$REAL_CARGO")"
  if [[ -d "$CARGO_PATH_ENTRY" ]]; then
    mount_args+=(--ro-bind "$CARGO_PATH_ENTRY" "$internal_cargo_bin")
    safe_path="$internal_cargo_bin:$safe_path"
  elif [[ -d "$CARGO_BIN_HOST" ]]; then
    mount_args+=(--ro-bind "$CARGO_BIN_HOST" "$internal_cargo_bin")
    safe_path="$internal_cargo_bin:$safe_path"
  fi
fi
if [[ -d "$RUSTUP_HOME_HOST" ]]; then
  mount_args+=(--ro-bind "$RUSTUP_HOME_HOST" "$internal_rustup")
fi

# Expose only dependency caches, never Cargo credentials/config. Caches are
# read-only and Cargo is forced offline; validation may write only its workspace
# target/output and private tmpfs state.
if [[ -d "$CARGO_HOME_HOST/registry" ]]; then
  mount_args+=(--dir "$internal_cargo_home/registry")
  for part in index cache src; do
    if [[ -d "$CARGO_HOME_HOST/registry/$part" ]]; then
      mount_args+=(--ro-bind "$CARGO_HOME_HOST/registry/$part" "$internal_cargo_home/registry/$part")
    fi
  done
fi
if [[ -d "$CARGO_HOME_HOST/git" ]]; then
  mount_args+=(--dir "$internal_cargo_home/git")
  for part in db checkouts; do
    if [[ -d "$CARGO_HOME_HOST/git/$part" ]]; then
      mount_args+=(--ro-bind "$CARGO_HOME_HOST/git/$part" "$internal_cargo_home/git/$part")
    fi
  done
fi

mask_args=()
add_tmpfs_mask() {
  local path="$1"
  [[ -n "$path" && -d "$path" ]] || return 0
  mask_args+=(--tmpfs "$path")
}
add_file_mask() {
  local path="$1"
  [[ -f "$path" ]] || return 0
  mask_args+=(--ro-bind /dev/null "$path")
}

add_tmpfs_mask "$HOST_HOME"
case "$RUNTIME_HOME" in
  "$HOST_HOME"|"$HOST_HOME"/*) ;;
  *) add_tmpfs_mask "$RUNTIME_HOME" ;;
esac
for path in /home /root /run /var/lib /var/log /mnt /media /srv; do
  add_tmpfs_mask "$path"
done
for path in /etc/ssh /etc/wpa_supplicant /etc/NetworkManager/system-connections; do
  add_tmpfs_mask "$path"
done
for path in /etc/shadow /etc/gshadow /etc/memorithm-orchestrator.env; do
  add_file_mask "$path"
done

env_args=(
  --clearenv
  --setenv HOME "$internal_home"
  --setenv TMPDIR /tmp
  --setenv PATH "$safe_path"
  --setenv CARGO_HOME "$internal_cargo_home"
  --setenv CARGO_NET_OFFLINE true
  --setenv LANG "${LANG:-C.UTF-8}"
  --setenv LC_ALL "${LC_ALL:-C.UTF-8}"
)
if [[ -d "$RUSTUP_HOME_HOST" ]]; then
  env_args+=(--setenv RUSTUP_HOME "$internal_rustup")
fi
for name in CUDA_HOME CUDA_PATH LD_LIBRARY_PATH LIBRARY_PATH CPATH PKG_CONFIG_PATH CMAKE_PREFIX_PATH RUSTFLAGS RUSTDOCFLAGS RUST_BACKTRACE CC CXX AR VULKAN_SDK; do
  if [[ -n "${!name:-}" ]]; then
    env_args+=(--setenv "$name" "${!name}")
  fi
done

exec "$BWRAP" \
  --die-with-parent \
  --new-session \
  --unshare-user \
  --uid 0 \
  --gid 0 \
  --unshare-pid \
  --unshare-ipc \
  --unshare-uts \
  --unshare-cgroup-try \
  --unshare-net \
  --cap-drop ALL \
  "${mount_args[@]}" \
  "${mask_args[@]}" \
  --chdir "$internal_cwd" \
  "${env_args[@]}" \
  -- \
  "$@"
