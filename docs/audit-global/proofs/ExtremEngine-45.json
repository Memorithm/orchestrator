  "change_summary": [
    "SceneDocument::instantiate validates the public document before any world mutation",
    "instantiation uses an iterative fallibly allocated plan and pre-reserved parent/child storage",
    "any mid-transaction world or capacity failure rolls back every entity created by the transaction",
    "Scene::from_ron rejects more than 8 MiB before serde allocation and applies caller-reducible hard-envelope limits",
    "seeded RON decoding enforces node, hierarchy-depth, individual-name and aggregate-name budgets while reading",
    "decoded node vectors grow geometrically; RON recursion is aligned with the configured hierarchy bound",
    "new limits and typed instantiation error are re-exported by the engine facade"
  ],
  "regressions": [
    "direct invalid document rejected without world mutation",
    "flat node excess rejected during decode",
    "encoded byte excess rejected before decode",
    "name excess rejected during decode",
    "direct hierarchy depth excess rejected without recursive instantiation",
    "direct aggregate name budget enforced before planning and cloning",
    "injected mid-instantiation capacity failure rolls back created entities"
  ],
