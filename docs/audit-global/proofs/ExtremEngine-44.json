  "change_summary": [
    "caps every supported accessor count before reserve",
    "proves checked (count-1)*stride+element_width within BIN view before allocation",
    "uses importer-owned try_reserve_exact and 128 MiB cumulative requested-decoded admission budget",
    "uses checked glTF u64 conversions without platform truncation",
    "matches unknown attributes before value conversion and uses bounded static labels"
  ],
  "regressions": [
    "maximum POSITION count",
    "impossible one-byte POSITION span",
    "maximum index count",
    "accessor stride/span overflow",
    "cumulative budget rejection before reserve",
    "unknown attribute rejected before value conversion"
  ],
